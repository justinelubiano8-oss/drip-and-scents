# Kopyahin ito bilang ".env" (local) o ilagay sa Vercel > Settings > Environment Variables
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Strapi admin > Settings > API Tokens (Custom: Product find/findOne/create/update/delete, Upload upload)
NUXT_STRAPI_TOKEN=
# Password para makapasok sa Manage products
NUXT_ADMIN_PASSWORD=
# Kahit anong mahabang random na text, hindi bababa sa 32 characters
NUXT_SESSION_SECRET=
